{
  "name": "araham-fintech-bse-ingestion",
  "version": "1.0.0",
  "description": "BSE Exchange Trade Ingestion Terminal & Resilient Pull Engine",
  "type": "module",
  "scripts": {
    "dev:bse": "tsx src/mock-bse/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n bse,server,client -c yellow,blue,green \"npm run dev:bse\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
